#!/usr/bin/env python3
"""
Parametric 6-compartment automatic pill dispenser
Compatible with MDP Smart Pill Dispenser project assumptions
(6 slots, one preloaded item per slot, servo gate release)

Dimensions chosen for easy FDM printing (PLA/PETG), common SG90/MG90S servo,
and typical tablet sizes. All units in mm.

Exports STL files ready for slicing.
"""

from solid import *
from solid.utils import *
import os

# ===================== PARAMETERS (edit these) =====================
NUM_COMPARTMENTS = 6
TRAY_OUTER_DIA = 120.0
TRAY_HEIGHT = 28.0
WALL = 2.2
SHAFT_DIA = 8.0          # central shaft / coupler hole
HUB_DIA = 22.0
COMPARTMENT_DEPTH = 22.0 # radial depth of each pocket
BASE_DIA = 140.0
BASE_HEIGHT = 45.0
ELECTRONICS_BAY_W = 70.0
ELECTRONICS_BAY_D = 55.0
ELECTRONICS_BAY_H = 28.0
OUTLET_W = 18.0
OUTLET_H = 14.0
SERVO_MOUNT_W = 23.0     # typical SG90 body width
SERVO_MOUNT_H = 12.0
GATE_THICK = 2.0
GATE_W = 20.0
GATE_H = 16.0
LID_HEIGHT = 4.0
CLEARANCE = 0.4          # print clearance

OUTPUT_DIR = os.path.dirname(os.path.abspath(__file__))

# ===================== HELPER =====================
def cylinder_z(h, r=None, d=None, center=False):
    if d is not None:
        r = d / 2.0
    return cylinder(h=h, r=r, center=center)

# ===================== TRAY (carousel) =====================
def make_tray():
    outer_r = TRAY_OUTER_DIA / 2
    hub_r = HUB_DIA / 2
    shaft_r = SHAFT_DIA / 2 + CLEARANCE / 2
    angle_step = 360.0 / NUM_COMPARTMENTS
    floor_h = WALL

    # Solid outer cylinder
    tray = cylinder_z(TRAY_HEIGHT, r=outer_r)

    # Remove material above the floor to create the open compartments
    # Keep outer wall thickness = WALL
    void = translate([0, 0, floor_h])(
        cylinder_z(TRAY_HEIGHT - floor_h + 1, r=outer_r - WALL)
    )
    tray = difference()(tray, void)

    # Add radial divider walls (from hub to outer wall)
    for i in range(NUM_COMPARTMENTS):
        a = i * angle_step
        wall = rotate([0, 0, a])(
            translate([hub_r - 1, -WALL / 2, 0])(
                cube([outer_r - hub_r + 2, WALL, TRAY_HEIGHT])
            )
        )
        tray = union()(tray, wall)

    # Solid central hub
    hub = cylinder_z(TRAY_HEIGHT, r=hub_r)
    tray = union()(tray, hub)

    # Shaft hole through hub
    shaft = translate([0, 0, -1])(
        cylinder_z(TRAY_HEIGHT + 2, r=shaft_r)
    )
    tray = difference()(tray, shaft)

    # Small radial indexing holes (for optical/home sensor)
    for i in range(NUM_COMPARTMENTS):
        a = i * angle_step + angle_step / 2.0
        hole = rotate([0, 0, a])(
            translate([outer_r - 5, 0, TRAY_HEIGHT / 2])(
                rotate([0, 90, 0])(
                    cylinder_z(10, r=1.6, center=True)
                )
            )
        )
        tray = difference()(tray, hole)

    return tray

# ===================== BASE =====================
def make_base():
    outer_r = BASE_DIA / 2
    base = cylinder_z(BASE_HEIGHT, r=outer_r)

    # Hollow main cavity for tray + mechanism
    cavity_r = TRAY_OUTER_DIA / 2 + 3
    cavity = translate([0, 0, 8])(
        cylinder_z(BASE_HEIGHT, r=cavity_r)
    )
    base = difference()(base, cavity)

    # Electronics bay (side cutout / pocket)
    bay = translate([
        outer_r - ELECTRONICS_BAY_D/2 - 8,
        -ELECTRONICS_BAY_W/2,
        5
    ])(
        cube([ELECTRONICS_BAY_D + 10, ELECTRONICS_BAY_W, ELECTRONICS_BAY_H])
    )
    base = difference()(base, bay)

    # Outlet chute at front
    outlet = translate([
        cavity_r - 5,
        -OUTLET_W/2,
        8
    ])(
        cube([30, OUTLET_W, OUTLET_H])
    )
    base = difference()(base, outlet)

    # Motor mount platform (central raised area under tray)
    mount = cylinder_z(10, r=28)
    base = union()(base, mount)

    # Shaft clearance hole through mount
    shaft_hole = cylinder_z(15, r=SHAFT_DIA/2 + 1.5)
    base = difference()(base, shaft_hole)

    # Servo mount pocket (for gate actuator) - near outlet
    servo_pocket = translate([
        cavity_r - 15,
        OUTLET_W/2 + 5,
        10
    ])(
        cube([SERVO_MOUNT_W + 2, 12, SERVO_MOUNT_H + 2])
    )
    base = difference()(base, servo_pocket)

    # Mounting screw holes for electronics / lid (M3)
    for angle in [45, 135, 225, 315]:
        hole = rotate([0, 0, angle])(
            translate([outer_r - 12, 0, 0])(
                cylinder_z(BASE_HEIGHT + 2, r=1.7)
            )
        )
        base = difference()(base, hole)

    # Bottom feet
    for angle in [0, 90, 180, 270]:
        foot = rotate([0, 0, angle])(
            translate([outer_r - 18, 0, 0])(
                cylinder_z(3, r=8)
            )
        )
        base = union()(base, foot)

    return base

# ===================== LID =====================
def make_lid():
    outer_r = TRAY_OUTER_DIA / 2 + 1.5
    lid = cylinder_z(LID_HEIGHT, r=outer_r)
    # Lip that sits on tray
    lip = translate([0, 0, -2])(
        difference()(
            cylinder_z(3, r=outer_r),
            cylinder_z(4, r=outer_r - 3)
        )
    )
    lid = union()(lid, lip)
    # Central handle / fill hole (optional small opening)
    fill = cylinder_z(LID_HEIGHT + 2, r=12)
    lid = difference()(lid, fill)
    # Label area
    return lid

# ===================== GATE (servo flap) =====================
def make_gate():
    # Simple rectangular flap with hinge pin holes
    gate = cube([GATE_W, GATE_THICK, GATE_H])
    # Hinge bosses
    boss1 = translate([-2, GATE_THICK/2, GATE_H - 3])(
        rotate([90, 0, 0])(cylinder_z(GATE_THICK + 4, r=2.5, center=True))
    )
    boss2 = translate([GATE_W + 2, GATE_THICK/2, GATE_H - 3])(
        rotate([90, 0, 0])(cylinder_z(GATE_THICK + 4, r=2.5, center=True))
    )
    gate = union()(gate, boss1, boss2)
    # Pin holes
    pin1 = translate([-2, GATE_THICK/2, GATE_H - 3])(
        rotate([90, 0, 0])(cylinder_z(GATE_THICK + 6, r=1.1, center=True))
    )
    pin2 = translate([GATE_W + 2, GATE_THICK/2, GATE_H - 3])(
        rotate([90, 0, 0])(cylinder_z(GATE_THICK + 6, r=1.1, center=True))
    )
    gate = difference()(gate, pin1, pin2)
    return gate

# ===================== GENERATE =====================
def export(obj, name):
    path = os.path.join(OUTPUT_DIR, f"{name}.scad")
    scad_render_to_file(obj, path, file_header=f"$fn = 64;\n// {name}\n")
    print(f"Wrote {path}")
    # Also try to produce STL via openscad if available, else leave .scad
    return path

if __name__ == "__main__":
    print("Generating parametric pill dispenser parts...")
    tray = make_tray()
    base = make_base()
    lid = make_lid()
    gate = make_gate()

    export(tray, "01_tray_carousel_6slot")
    export(base, "02_base_enclosure")
    export(lid, "03_lid")
    export(gate, "04_servo_gate")

    # Assembly preview (not for print)
    assembly = union()(
        base,
        translate([0, 0, 12])(color("orange")(tray)),
        translate([0, 0, 12 + TRAY_HEIGHT + 1])(color("lightblue")(lid)),
        translate([TRAY_OUTER_DIA/2 - 5, -GATE_W/2, 12])(color("red")(gate))
    )
    export(assembly, "00_assembly_preview")

    print("\nDone. Open the .scad files in OpenSCAD (free) → Design → Export as STL")
    print("Or use FreeCAD: File → Import → select .scad (or convert via OpenSCAD)")
    print(f"Files are in: {OUTPUT_DIR}")
 
 
